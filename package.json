{
  "name": "mcgipro-operator-scheduler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pg": "vite --mode pg",
    "db:setup": "createdb mcgi_board 2>/dev/null; PGOPTIONS=--client-min-messages=warning psql -v ON_ERROR_STOP=1 -q -d mcgi_board -f db/local-schema.sql && echo \"✓ mcgi_board ready\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate:config": "tsx scripts/validate-config.ts",
    "test:e2e": "playwright test",
    "test:e2e:pg": "E2E_PG=1 playwright test --project=pg"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^5.1.0",
    "gh-pages": "^6.1.1",
    "pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}

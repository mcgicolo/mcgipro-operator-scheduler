# Supabase project credentials (Supabase dashboard → Project Settings → API).
# Both values are public by design; access is limited by the RLS policy in supabase/schema.sql.
# Leave them empty to run the app in local demo mode (localStorage + cross-tab sync, no backend).
# For a local PostgreSQL instead, run `npm run db:setup` then `npm run dev:pg` (settings live in .env.pg).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
